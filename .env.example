# =============================================================================
# Docline SDR — variáveis de ambiente (MODELO)
#
# Copie para `.env` e preencha localmente. NUNCA commite o arquivo `.env`.
# Todos os valores abaixo são placeholders ou padrões de desenvolvimento —
# nenhum é segredo real. Em staging/produção, configure no provedor de
# hospedagem (ex.: Render environment groups) ou em um cofre de segredos.
#
# Documentação: docs/SECURITY.md §5 e docs/INTEGRATIONS.md §4
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Fortaleza
LOG_LEVEL=info

# --- Banco de dados ----------------------------------------------------------
DATABASE_URL=postgresql://docline:docline@localhost:5432/docline_sdr?schema=public
# Fila de jobs (pg-boss) usa o mesmo PostgreSQL, em schema separado.
JOB_QUEUE_SCHEMA=pgboss
# Redis NÃO é necessário no MVP (ver docs/ARCHITECTURE.md, ADR-003).
# Reservado para cache/rate limit distribuído no futuro.
REDIS_URL=

# --- Autenticação (Better Auth) ---------------------------------------------
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Criptografia e hashing --------------------------------------------------
# Chave de 32 bytes em base64 para criptografar credenciais de integração
# guardadas no banco (AES-256-GCM). Gere com: openssl rand -base64 32
ENCRYPTION_KEY=
# Segredo do HMAC da Lista Não Contatar. NÃO ROTACIONAR sem plano de migração:
# os hashes de opt-out dependem dele. Guarde uma cópia segura.
SUPPRESSION_HASH_PEPPER=

# --- Seleção de provedores (adaptadores) ------------------------------------
# Fora de produção, use sempre fake/assisted/disabled.
WHATSAPP_PROVIDER=assisted            # assisted | fake | meta_cloud
INSTAGRAM_PROVIDER=assisted           # assisted | fake | meta_graph
PLACES_PROVIDER=fake                  # disabled | fake | google_places
COMPANY_REGISTRY_PROVIDER=fake        # disabled | fake | receita_open_data | brasilapi
AI_PROVIDER=fake                      # fake | anthropic
EMAIL_PROVIDER=console                # console | smtp | resend
CRM_PROVIDER=disabled                 # disabled | fake | webhook | docline
# Trava de segurança: adaptadores de envio real só operam fora de produção
# se este valor for explicitamente "true".
ALLOW_REAL_SENDS=false

# --- Meta: WhatsApp Business Platform / Instagram (Fases 7 e 8) -------------
META_APP_ID=
META_APP_SECRET=
# Token de System User (não de pessoa física), com menor privilégio e rotação.
META_ACCESS_TOKEN=
# Fixe a versão da Graph API e atualize de forma planejada.
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Google (Fase 9 — somente após parecer jurídico) ------------------------
# Restrinja a chave por API e por IP/origem; configure cotas e alertas.
GOOGLE_API_KEY=
GOOGLE_PLACES_DAILY_QUOTA=200

# --- IA — SDR AI (Fase 6) ----------------------------------------------------
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Vazio = usa AI_MODEL.
AI_MODEL_CLASSIFICATION=
AI_EFFORT_GENERATION=medium           # low | medium | high
AI_EFFORT_CLASSIFICATION=low          # low | medium | high
AI_MAX_GENERATIONS_PER_USER_PER_DAY=200
# Orçamento mensal em US$ (alerta em 80%, bloqueio em 100%). Vazio = sem limite.
AI_MONTHLY_BUDGET_USD=

# --- E-mail transacional (convites, redefinição de senha) -------------------
EMAIL_FROM="Docline SDR <nao-responda@example.com>"
# Ex.: smtp://usuario:senha@smtp.example.com:587 (Mailpit local: smtp://localhost:1025)
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=

# --- Armazenamento de arquivos (opcional; o MVP não persiste uploads) -------
STORAGE_PROVIDER=none                 # none | s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Integrações Docline (Fase 12) ------------------------------------------
DOCLINE_CRM_BASE_URL=
DOCLINE_CRM_API_KEY=
OUTBOUND_WEBHOOK_SIGNING_SECRET=

# --- Limites operacionais ----------------------------------------------------
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=50000
