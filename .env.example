# =============================================================================
# Docline SDR — variáveis de ambiente (MODELO)
#
# Copie para `.env` e preencha localmente. NUNCA commite o arquivo `.env`.
# Todos os valores abaixo são placeholders ou padrões de desenvolvimento —
# nenhum é segredo real. Em staging/produção, configure no provedor de
# hospedagem (ex.: Render environment groups) ou em um cofre de segredos.
#
# Documentação: docs/SECURITY.md §5 e docs/INTEGRATIONS.md §4
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# Ambiente lógico da aplicação (independe do NODE_ENV do Next.js):
# development | test | staging | production
APP_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Fortaleza
LOG_LEVEL=info
# Proxies confiáveis à frente da aplicação (IPs ou CIDRs, separados por vírgula),
# para obter o IP real do cliente sem aceitar X-Forwarded-For forjado.
# Vazio = só aceita o cabeçalho quando ele traz um único IP. Ver SECURITY §12.
TRUSTED_PROXIES=

# --- Banco de dados ----------------------------------------------------------
DATABASE_URL=postgresql://docline:docline@localhost:5432/docline_sdr?schema=public
# Banco exclusivo dos testes de integração (é apagado e recriado pelos testes).
DATABASE_URL_TEST=postgresql://docline:docline@localhost:5432/docline_sdr_test?schema=public
# Fila de jobs (pg-boss) usa o mesmo PostgreSQL, em schema separado.
JOB_QUEUE_SCHEMA=pgboss
# Redis NÃO é necessário no MVP (ver docs/ARCHITECTURE.md, ADR-003).
# Reservado para cache/rate limit distribuído no futuro.
REDIS_URL=

# --- Autenticação (Better Auth) ---------------------------------------------
# Gere com: openssl rand -base64 32
# Também cifra os segredos da verificação em duas etapas: trocar este valor encerra
# as sessões e obriga cada usuário a reativar a 2FA.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Verificação em duas etapas de ADMIN e GESTOR: "required" bloqueia o acesso
# (só "Minha conta") até ativar; "reminder" só mostra o lembrete e é recusado
# em staging e produção.
TWO_FACTOR_ENFORCEMENT=required

# --- Criptografia e hashing --------------------------------------------------
# Chave de 32 bytes em base64 para criptografar credenciais de integração
# guardadas no banco (AES-256-GCM). Gere com: openssl rand -base64 32
ENCRYPTION_KEY=
# Segredo do HMAC da Lista Não Contatar (obrigatório em todos os ambientes, mín.
# 32 caracteres). NÃO ROTACIONAR sem plano de migração: os hashes de opt-out
# dependem dele. Guarde uma cópia segura. Gere com: openssl rand -base64 32
SUPPRESSION_HASH_PEPPER=

# --- Seleção de provedores (adaptadores) ------------------------------------
# Fora de produção, use sempre fake/assisted/disabled.
WHATSAPP_PROVIDER=assisted            # assisted | fake | meta_cloud
INSTAGRAM_PROVIDER=assisted           # assisted | fake | meta_graph
PLACES_PROVIDER=fake                  # disabled | fake | google_places
COMPANY_REGISTRY_PROVIDER=fake        # disabled | fake | receita_open_data | brasilapi
AI_PROVIDER=fake                      # fake | anthropic
EMAIL_PROVIDER=console                # console | file | smtp | resend
CRM_PROVIDER=disabled                 # disabled | fake | webhook | docline
# Trava de segurança: adaptadores de envio real só operam fora de produção
# se este valor for explicitamente "true".
ALLOW_REAL_SENDS=false

# --- Meta: WhatsApp Business Platform / Instagram (Fases 7 e 8) -------------
# WhatsApp: "assisted" só gera o link wa.me; "fake" simula a Cloud API sem
# enviar nada (webhooks simulados com `pnpm whatsapp:simulate`); "meta_cloud"
# usa a Cloud API e, fora de produção, só envia com ALLOW_REAL_SENDS=true.
# Instagram: "assisted" só abre o perfil e copia o texto; "fake" simula a API
# (webhooks simulados com `pnpm instagram:simulate`); "meta_graph" usa a API
# do Instagram com Facebook Login e, fora de produção, só envia com
# ALLOW_REAL_SENDS=true. Os dois canais usam o mesmo app da Meta.
META_APP_ID=
# Assina os webhooks (X-Hub-Signature-256). Com "fake", defina um valor de
# teste para receber webhooks simulados; sem ele, o endpoint não aceita nada.
META_APP_SECRET=
# Token de System User (não de pessoa física), com menor privilégio e rotação.
META_ACCESS_TOKEN=
# Fixe a versão da Graph API (ex.: v26.0) e atualize de forma planejada.
META_GRAPH_API_VERSION=
# Token que você escolhe e informa no painel da Meta ao cadastrar o webhook.
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Instagram: id da conta profissional, da Página ligada a ela e o token da
# Página gerado por um System User (instagram_basic, instagram_manage_messages,
# instagram_manage_comments, pages_manage_metadata, pages_read_engagement…).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=

# --- Google (Fase 9 — somente após parecer jurídico) ------------------------
# Restrinja a chave por API e por IP/origem; configure cotas e alertas.
GOOGLE_API_KEY=
GOOGLE_PLACES_DAILY_QUOTA=200

# --- IA — SDR AI (Fase 6) ----------------------------------------------------
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Vazio = usa AI_MODEL.
AI_MODEL_CLASSIFICATION=
AI_EFFORT_GENERATION=medium           # low | medium | high
AI_EFFORT_CLASSIFICATION=low          # low | medium | high
AI_MAX_GENERATIONS_PER_USER_PER_DAY=200
# Orçamento mensal em US$ (alerta em 80%, bloqueio em 100%). Vazio = sem limite.
AI_MONTHLY_BUDGET_USD=

# --- E-mail transacional (convites, redefinição de senha) -------------------
EMAIL_FROM="Docline SDR <nao-responda@example.com>"
# Ex.: smtp://usuario:senha@smtp.example.com:587 (Mailpit local: smtp://localhost:1025)
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
# Somente com EMAIL_PROVIDER=file (dev/testes): e-mails gravados como JSON por linha.
EMAIL_OUTBOX_FILE=.data/outbox.jsonl

# --- Observabilidade ---------------------------------------------------------
# Opcional. Com o DSN do projeto no Sentry, erros do web e do worker são enviados
# sem dados pessoais (sem usuário, cookies ou corpo; e-mails e números mascarados).
# Vazio: nada é enviado (erros continuam nos logs com requestId).
SENTRY_DSN=

# --- Armazenamento de arquivos (opcional; o MVP não persiste uploads) -------
STORAGE_PROVIDER=none                 # none | s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Integrações Docline (Fase 12) ------------------------------------------
DOCLINE_CRM_BASE_URL=
DOCLINE_CRM_API_KEY=
OUTBOUND_WEBHOOK_SIGNING_SECRET=

# --- Limites operacionais ----------------------------------------------------
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=50000
