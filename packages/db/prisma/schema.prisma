  leadAId      String              @map("lead_a_id") @db.Uuid
  leadBId      String              @map("lead_b_id") @db.Uuid
  /// 0 a 1.
  score        Float
  confidence   DuplicateConfidence
  /// `[{rule, detail, weight}]`, sem dados pessoais em claro.
  reasons      Json
  status       DuplicateStatus     @default(PENDING)
  detectedBy   DuplicateSource     @map("detected_by")
  detectedAt   DateTime            @default(now()) @map("detected_at") @db.Timestamptz(3)
  decidedById  String?             @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote String?             @map("decision_note")

  leadA     Lead        @relation("CandidateA", fields: [leadAId], references: [id], onDelete: Cascade)
  leadB     Lead        @relation("CandidateB", fields: [leadBId], references: [id], onDelete: Cascade)
  decidedBy User?       @relation("CandidateDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  merges    LeadMerge[]

  @@unique([leadAId, leadBId])
  @@index([status, confidence, score(sort: Desc)])
  @@index([leadBId])
  @@map("duplicate_candidates")
}

/// Mesclagem: o lead mesclado vira MERGED e aponta para o sobrevivente; a cópia
/// integral fica em `merged_snapshot` (nada é excluído; docs/MVP.md M06).
model LeadMerge {
  id             String   @id @default(uuid(7)) @db.Uuid
  survivorLeadId String   @map("survivor_lead_id") @db.Uuid
  mergedLeadId   String   @map("merged_lead_id") @db.Uuid
  candidateId    String?  @map("candidate_id") @db.Uuid
  /// Campo → "survivor" | "merged", como escolhido na tela.
  fieldChoices   Json     @map("field_choices")
  /// Cópia do lead mesclado e ids dos filhos movidos.
  mergedSnapshot Json     @map("merged_snapshot")
  performedById  String?  @map("performed_by_id") @db.Uuid
  performedAt    DateTime @default(now()) @map("performed_at") @db.Timestamptz(3)

  survivor    Lead                @relation("MergeSurvivor", fields: [survivorLeadId], references: [id])
  merged      Lead                @relation("MergeMerged", fields: [mergedLeadId], references: [id])
  candidate   DuplicateCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  performedBy User?               @relation("MergePerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([survivorLeadId])
  @@index([mergedLeadId])
  @@map("lead_merges")
}

// -----------------------------------------------------------------------------
// Pipeline e score (Fase 4)
// -----------------------------------------------------------------------------

enum StageCategory {
  OPEN
  WON
  LOST
  /// Parado, à espera de reativação (ex.: Sem resposta).
  PARKED

  @@map("stage_category")
}

/// Perfil que costuma trabalhar a etapa (informativo no quadro).
enum StageOwner {
  SDR
  SALES

  @@map("stage_owner")
}

/// Quem moveu o lead quando não foi uma pessoa.
enum StageChangeSource {
  CADENCE
  INBOUND
  IMPORT
  HANDOFF
  RULE
  MERGE

  @@map("stage_change_source")
}

enum ScoreBand {
  COLD
  WARM
  HOT
  PRIORITY

  @@map("score_band")
}

enum ScoringModelStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("scoring_model_status")
}

/// CLAMP: soma limitada a 0–100. SCALE: soma reescalada entre o mínimo e o máximo possíveis.
enum ScoreNormalization {
  CLAMP
  SCALE

  @@map("score_normalization")
}

model Pipeline {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Chave estável (o padrão é DEFAULT).
  key       String   @unique
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stages PipelineStage[]
  leads  Lead[]

  @@unique([isDefault], map: "pipelines_default_key", where: raw("is_default"))
  @@map("pipelines")
}

/// Etapa do pipeline (docs/DATABASE.md §8.1). Nome, cor, ordem e SLA são
/// editáveis; a `key` é estável e usada pelas regras e automações.
model PipelineStage {
  id                 String        @id @default(uuid(7)) @db.Uuid
  pipelineId         String        @map("pipeline_id") @db.Uuid
  key                String
  name               String
  position           Int
  category           StageCategory
  ownerRole          StageOwner?   @map("owner_role")
  color              String        @default("slate")
  requiresLossReason Boolean       @default(false) @map("requires_loss_reason")
  slaHours           Int?          @map("sla_hours")
  /// Etapa do seed: não pode ser desativada (as automações dependem dela).
  isSystem           Boolean       @default(false) @map("is_system")
  active             Boolean       @default(true)
  description        String?
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  pipeline    Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads       Lead[]
  historyFrom LeadStageHistory[] @relation("StageFrom")
  historyTo   LeadStageHistory[] @relation("StageTo")

  @@unique([pipelineId, key])
  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model LossReason {
  id                 String   @id @default(uuid(7)) @db.Uuid
  key                String   @unique
  name               String
  /// Etapas de perda em que o motivo aparece (vazio = todas).
  appliesToStageKeys String[] @default([]) @map("applies_to_stage_keys")
  position           Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads         Lead[]
  history       LeadStageHistory[]
  opportunities Opportunity[]

  @@map("loss_reasons")
}

/// Passagem do lead por uma etapa; a linha aberta (`left_at` nulo) é a atual.
model LeadStageHistory {
  id               String             @id @default(uuid(7)) @db.Uuid
  leadId           String             @map("lead_id") @db.Uuid
  fromStageId      String?            @map("from_stage_id") @db.Uuid
  toStageId        String             @map("to_stage_id") @db.Uuid
  /// Nulo quando foi o sistema (ver `automation_source`).
  changedById      String?            @map("changed_by_id") @db.Uuid
  automationSource StageChangeSource? @map("automation_source")
  lossReasonId     String?            @map("loss_reason_id") @db.Uuid
  note             String?
  enteredAt        DateTime           @map("entered_at") @db.Timestamptz(3)
  leftAt           DateTime?          @map("left_at") @db.Timestamptz(3)
  /// Tempo na etapa, preenchido na saída.
  durationSeconds  Int?               @map("duration_seconds")

  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage  PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id])
  toStage    PipelineStage  @relation("StageTo", fields: [toStageId], references: [id])
  changedBy  User?          @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  lossReason LossReason?    @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)

  @@unique([leadId], map: "lead_stage_history_open_key", where: raw("left_at IS NULL"))
  @@index([leadId, enteredAt(sort: Desc)])
  @@index([toStageId, enteredAt])
  @@map("lead_stage_history")
}

/// Cidades em que a Docline quer concentrar a prospecção (critério do score).
model PriorityCity {
  municipalityCode Int      @id @map("municipality_code")
  /// Peso relativo, para uso futuro (hoje o critério só confere se a cidade está na lista).
  weight           Int      @default(1)
  active           Boolean  @default(true)
  notes            String?
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  municipality Municipality @relation(fields: [municipalityCode], references: [ibgeCode])
  createdBy    User?        @relation("PriorityCityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("priority_cities")
}

/// Versão do modelo de score: só uma ACTIVE; rascunhos são editáveis e simuláveis.
model ScoringModel {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String
  version       Int                @unique
  status        ScoringModelStatus @default(DRAFT)
  normalization ScoreNormalization @default(CLAMP)
  /// `[{band, min, max}]`, cobrindo 0–100 sem buracos.
  bands         Json
  notes         String?
  createdById   String?            @map("created_by_id") @db.Uuid
  activatedAt   DateTime?          @map("activated_at") @db.Timestamptz(3)
  activatedById String?            @map("activated_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  rules       ScoringRule[]
  history     LeadScoreHistory[]
  leads       Lead[]
  createdBy   User?              @relation("ScoringModelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activatedBy User?              @relation("ScoringModelActivator", fields: [activatedById], references: [id], onDelete: SetNull)

  @@unique([status], map: "scoring_models_active_key", where: raw("status = 'ACTIVE'"))
  @@map("scoring_models")
}

/// Regra do modelo: critério registrado no código, parâmetros e pontos (aceita negativos).
model ScoringRule {
  id           String  @id @default(uuid(7)) @db.Uuid
  modelId      String  @map("model_id") @db.Uuid
  criterionKey String  @map("criterion_key")
  params       Json    @default("{}")
  points       Int
  active       Boolean @default(true)
  position     Int
  description  String?

  model ScoringModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId, position])
  @@map("scoring_rules")
}

/// Histórico de score: só grava quando o score ou a faixa mudam.
model LeadScoreHistory {
  id            String     @id @default(uuid(7)) @db.Uuid
  leadId        String     @map("lead_id") @db.Uuid
  modelId       String     @map("model_id") @db.Uuid
  score         Int
  band          ScoreBand
  previousScore Int?       @map("previous_score")
  previousBand  ScoreBand? @map("previous_band")
  /// `[{criterion, label, matched, points, detail}]`.
  breakdown     Json
  /// O que provocou o cálculo (ex.: contact_state, lead.update, model.activated).
  trigger       String
  computedAt    DateTime   @map("computed_at") @db.Timestamptz(3)

  lead  Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  model ScoringModel @relation(fields: [modelId], references: [id])

  @@index([leadId, computedAt(sort: Desc)])
  @@map("lead_score_history")
}

// -----------------------------------------------------------------------------
// Operação SDR (Fase 5): tarefas, atividades, mensagens, cadências,
// oportunidades e notificações
// -----------------------------------------------------------------------------

enum TaskType {
  FIRST_CONTACT
  FOLLOW_UP
  REPLY_NEEDED
  CALL
  MEETING
  HANDOFF_REVIEW
  CUSTOM

  @@map("task_type")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
  SKIPPED

  @@map("task_status")
}

/// Tarefa do SDR (ou do comercial, na transferência). Passos de cadência viram
/// tarefas: nada é enviado sem ação humana no MVP.
model Task {
  id                String          @id @default(uuid(7)) @db.Uuid
  leadId            String          @map("lead_id") @db.Uuid
  assigneeId        String?         @map("assignee_id") @db.Uuid
  type              TaskType
  title             String
  description       String?
  dueAt             DateTime        @map("due_at") @db.Timestamptz(3)
  status            TaskStatus      @default(OPEN)
  /// Resultado informado ao concluir (texto curto).
  outcome           String?
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(3)
  completedById     String?         @map("completed_by_id") @db.Uuid
  /// Passo de cadência que gerou a tarefa.
  enrollmentId      String?         @map("enrollment_id") @db.Uuid
  cadenceStepId     String?         @map("cadence_step_id") @db.Uuid
  /// Mensagem sugerida e canal do passo (copiados do passo na criação).
  messageType       MessageType?    @map("message_type")
  channel           CadenceChannel?
  /// Aviso de atraso já enviado (o job de atrasados avisa uma vez).
  overdueNotifiedAt DateTime?       @map("overdue_notified_at") @db.Timestamptz(3)
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy User?              @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  enrollment  CadenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  cadenceStep CadenceStep?       @relation(fields: [cadenceStepId], references: [id], onDelete: SetNull)
  messages    Message[]
  activities  Activity[]

  /// Uma tarefa aberta por inscrição de cadência (o passo atual).
  @@unique([enrollmentId], map: "tasks_open_enrollment_key", where: raw("status = 'OPEN' AND enrollment_id IS NOT NULL"))
  @@index([assigneeId, status, dueAt])
  @@index([leadId, status])
  @@index([status, dueAt])
  @@map("tasks")
}

enum ActivityType {
  CALL
  MEETING
  VISIT
  EMAIL_EXTERNAL
  OTHER

  @@map("activity_type")
}

enum ActivityOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  VOICEMAIL
  HELD
  NO_SHOW

  @@map("activity_outcome")
}

enum MessageDirection {
  OUTBOUND
  INBOUND

  @@map("message_direction")
}

/// Interação que não é mensagem: ligação, reunião, visita.
model Activity {
  id              String           @id @default(uuid(7)) @db.Uuid
  leadId          String           @map("lead_id") @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  type            ActivityType
  direction       MessageDirection @default(OUTBOUND)
  outcome         ActivityOutcome?
  notes           String?
  occurredAt      DateTime         @map("occurred_at") @db.Timestamptz(3)
  durationSeconds Int?             @map("duration_seconds")
  /// Tarefa concluída com este registro.
  taskId          String?          @map("task_id") @db.Uuid
  contactPointId  String?          @map("contact_point_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?         @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  contactPoint ContactPoint? @relation(fields: [contactPointId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt(sort: Desc)])
  @@map("activities")
}

enum MessageMode {
  /// O humano enviou no app (WhatsApp, Instagram) e confirmou no sistema.
  ASSISTED
  /// Enviado pelo sistema (Fase 7).
  API
  /// Registro manual retroativo (contato fora do fluxo, resposta colada).
  LOGGED

  @@map("message_mode")
}

enum MessageType {
  FIRST_CONTACT
  FOLLOW_UP_1
  FOLLOW_UP_2
  FOLLOW_UP_3
  INTERESTED_REPLY
  OBJECTION_REPLY
  SCHEDULING
  REACTIVATION
  OTHER

  @@map("message_type")
}

enum MessageStatus {
  PENDING_CONFIRMATION
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
  CANCELED

  @@map("message_status")
}

enum ReplyClassification {
  INTERESTED
  QUESTION
  OBJECTION
  NOT_INTERESTED
  OPT_OUT
  OUT_OF_OFFICE
  WRONG_CONTACT
  OTHER

  @@map("reply_classification")
}

enum ClassificationSource {
  RULE
  AI
  HUMAN

  @@map("classification_source")
}

/// Mensagem enviada ou recebida. `body` é o texto efetivamente enviado (ou o
/// recebido, colado pelo SDR): dado pessoal, apagado na anonimização.
model Message {
  id                       String                @id @default(uuid(7)) @db.Uuid
  leadId                   String                @map("lead_id") @db.Uuid
  contactPointId           String?               @map("contact_point_id") @db.Uuid
  channel                  Channel
  direction                MessageDirection
  mode                     MessageMode
  messageType              MessageType?          @map("message_type")
  body                     String?
  status                   MessageStatus
  /// Primeiro contato do lead (conta no limite diário por SDR).
  isFirstContact           Boolean               @default(false) @map("is_first_contact")
  taskId                   String?               @map("task_id") @db.Uuid
  enrollmentId             String?               @map("enrollment_id") @db.Uuid
  cadenceStepId            String?               @map("cadence_step_id") @db.Uuid
  sentById                 String?               @map("sent_by_id") @db.Uuid
  sentAt                   DateTime?             @map("sent_at") @db.Timestamptz(3)
  receivedAt               DateTime?             @map("received_at") @db.Timestamptz(3)
  canceledAt               DateTime?             @map("canceled_at") @db.Timestamptz(3)
  classification           ReplyClassification?
  classificationSource     ClassificationSource? @map("classification_source")
  classificationConfidence Decimal?              @map("classification_confidence") @db.Decimal(4, 3)
  classifiedById           String?               @map("classified_by_id") @db.Uuid
  classifiedAt             DateTime?             @map("classified_at") @db.Timestamptz(3)
  /// Expressão de opt-out encontrada no texto recebido (regra determinística).
  optOutMatch              String?               @map("opt_out_match")
  provider                 String?
  providerMessageId        String?               @map("provider_message_id")
  idempotencyKey           String?               @unique @map("idempotency_key")
  createdById              String?               @map("created_by_id") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactPoint ContactPoint?      @relation(fields: [contactPointId], references: [id], onDelete: SetNull)
  task         Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  enrollment   CadenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  cadenceStep  CadenceStep?       @relation(fields: [cadenceStepId], references: [id], onDelete: SetNull)
  sentBy       User?              @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  classifiedBy User?              @relation("MessageClassifiedBy", fields: [classifiedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerMessageId])
  @@index([leadId, createdAt(sort: Desc)])
  @@index([sentById, status])
  /// Limite diário de primeiros contatos por SDR.
  @@index([sentById, sentAt], map: "messages_first_contact_idx", where: raw("is_first_contact"))
  @@map("messages")
}

enum CadenceChannel {
  WHATSAPP
  INSTAGRAM
  EMAIL
  PHONE
  ANY

  @@map("cadence_channel")
}

enum CadenceStepAction {
  ASSISTED_MESSAGE
  API_MESSAGE
  CALL
  TASK

  @@map("cadence_step_action")
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED

  @@map("enrollment_status")
}

enum EnrollmentStopReason {
  REPLIED
  OPTED_OUT
  MANUAL
  STAGE_CHANGED
  LEAD_ARCHIVED
  CONTACT_INVALID

  @@map("enrollment_stop_reason")
}

/// Cadência de follow-up (docs/SDR-FLOW.md §4). Editar passos ou regras sobe a
/// `version`; as inscrições guardam a versão em que entraram.
model Cadence {
  id                  String   @id @default(uuid(7)) @db.Uuid
  /// Chave estável (a padrão é DEFAULT).
  key                 String   @unique
  name                String
  description         String?
  version             Int      @default(1)
  active              Boolean  @default(true)
  isDefault           Boolean  @default(false) @map("is_default")
  stopOnReply         Boolean  @default(true) @map("stop_on_reply")
  useBusinessDays     Boolean  @default(true) @map("use_business_days")
  /// Janela de vencimento das tarefas, na hora local do lead ("08:00").
  sendWindowStart     String   @default("08:00") @map("send_window_start") @db.VarChar(5)
  sendWindowEnd       String   @default("18:00") @map("send_window_end") @db.VarChar(5)
  /// Dias após o último passo, sem resposta, para ir a "Sem resposta".
  noResponseAfterDays Int      @default(3) @map("no_response_after_days")
  createdById         String?  @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]
  createdBy   User?               @relation("CadenceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([isDefault], map: "cadences_default_key", where: raw("is_default"))
  @@map("cadences")
}

model CadenceStep {
  id             String            @id @default(uuid(7)) @db.Uuid
  cadenceId      String            @map("cadence_id") @db.Uuid
  position       Int
  /// Dia do passo contado do início da cadência (D0, D2, D5…).
  dayOffset      Int               @map("day_offset")
  channel        CadenceChannel    @default(WHATSAPP)
  action         CadenceStepAction @default(ASSISTED_MESSAGE)
  messageType    MessageType       @map("message_type")
  /// Etapa para onde o lead vai quando o passo é executado.
  targetStageKey String?           @map("target_stage_key")
  instructions   String?

  cadence  Cadence   @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  tasks    Task[]
  messages Message[]

  @@unique([cadenceId, position])
  @@map("cadence_steps")
}

/// Lead numa cadência: uma inscrição ACTIVE ou PAUSED por lead.
model CadenceEnrollment {
  id                  String                @id @default(uuid(7)) @db.Uuid
  leadId              String                @map("lead_id") @db.Uuid
  cadenceId           String                @map("cadence_id") @db.Uuid
  cadenceVersion      Int                   @map("cadence_version")
  status              EnrollmentStatus      @default(ACTIVE)
  stopReason          EnrollmentStopReason? @map("stop_reason")
  /// Passo à espera de execução (nulo: todos executados; corre o prazo de "Sem resposta").
  currentStepPosition Int?                  @map("current_step_position")
  /// Vencimento do passo atual ou, sem passo, do prazo de "Sem resposta".
  nextStepDueAt       DateTime?             @map("next_step_due_at") @db.Timestamptz(3)
  lastStepExecutedAt  DateTime?             @map("last_step_executed_at") @db.Timestamptz(3)
  /// Pausa com data de retomada (ex.: resposta "fora do escritório").
  pausedUntil         DateTime?             @map("paused_until") @db.Timestamptz(3)
  enrolledById        String?               @map("enrolled_by_id") @db.Uuid
  enrolledAt          DateTime              @map("enrolled_at") @db.Timestamptz(3)
  endedAt             DateTime?             @map("ended_at") @db.Timestamptz(3)

  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cadence    Cadence   @relation(fields: [cadenceId], references: [id])
  enrolledBy User?     @relation("EnrollmentBy", fields: [enrolledById], references: [id], onDelete: SetNull)
  tasks      Task[]
  messages   Message[]

  @@unique([leadId], map: "cadence_enrollments_active_key", where: raw("status = 'ACTIVE' OR status = 'PAUSED'"))
  @@index([status, nextStepDueAt])
  @@index([leadId, enrolledAt(sort: Desc)])
  @@map("cadence_enrollments")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST

  @@map("opportunity_status")
}

enum ConversionType {
  PARTNER
  CUSTOMER

  @@map("conversion_type")
}

/// Transferência ao Comercial (docs/SDR-FLOW.md §8): uma oportunidade aberta por lead.
model Opportunity {
  id              String            @id @default(uuid(7)) @db.Uuid
  leadId          String            @map("lead_id") @db.Uuid
  sdrId           String?           @map("sdr_id") @db.Uuid
  salesOwnerId    String?           @map("sales_owner_id") @db.Uuid
  status          OpportunityStatus @default(OPEN)
  handoffAt       DateTime          @map("handoff_at") @db.Timestamptz(3)
  /// Prazo de aceite pelo comercial (SLA).
  acceptDueAt     DateTime          @map("accept_due_at") @db.Timestamptz(3)
  acceptedAt      DateTime?         @map("accepted_at") @db.Timestamptz(3)
  /// Aviso ao gestor de aceite atrasado já enviado.
  slaAlertedAt    DateTime?         @map("sla_alerted_at") @db.Timestamptz(3)
  /// Checklist de qualificação (docs/SDR-FLOW.md §8.1).
  qualification   Json
  productInterest String?           @map("product_interest")
  expectedValue   Decimal?          @map("expected_value") @db.Decimal(12, 2)
  wonAt           DateTime?         @map("won_at") @db.Timestamptz(3)
  lostAt          DateTime?         @map("lost_at") @db.Timestamptz(3)
  lossReasonId    String?           @map("loss_reason_id") @db.Uuid
  conversionType  ConversionType?   @map("conversion_type")
  notes           String?
  externalCrmId   String?           @map("external_crm_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sdr        User?       @relation("OpportunitySdr", fields: [sdrId], references: [id], onDelete: SetNull)
  salesOwner User?       @relation("OpportunitySalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  lossReason LossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)

  @@unique([leadId], map: "opportunities_open_key", where: raw("status = 'OPEN'"))
  @@index([salesOwnerId, status])
  @@index([status, acceptDueAt])
  @@map("opportunities")
}

/// Aviso no app (sino do cabeçalho). Sem dados pessoais além do nome do lead.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Ex.: handoff.created, handoff.sla, task.overdue, leads.forgotten.
  type      String
  title     String
  body      String?
  leadId    String?   @map("lead_id") @db.Uuid
  /// Caminho interno da tela (ex.: /leads/{id}).
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}
