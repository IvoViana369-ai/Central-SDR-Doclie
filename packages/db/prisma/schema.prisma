/// Observação livre (sem dados sensíveis: docs/LGPD.md §11). Remoção é lógica e auditada.
model LeadNote {
  id          String    @id @default(uuid(7)) @db.Uuid
  leadId      String    @map("lead_id") @db.Uuid
