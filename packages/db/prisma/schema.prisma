/// Território atendido por um usuário: UF inteira (`municipalityCode` nulo) ou cidade.
/// Define o pool não atribuído que o SDR enxerga (docs/SECURITY.md §4.1).
model UserTerritory {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  stateUf          String   @map("state_uf") @db.Char(2)
  municipalityCode Int?     @map("municipality_code")
  priority         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        State         @relation(fields: [stateUf], references: [uf])
  municipality Municipality? @relation(fields: [municipalityCode], references: [ibgeCode])

  @@unique([userId, stateUf], map: "user_territories_state_key", where: raw("municipality_code IS NULL"))
  @@unique([userId, municipalityCode], map: "user_territories_city_key", where: raw("municipality_code IS NOT NULL"))
  @@index([stateUf, municipalityCode])
  @@map("user_territories")
}

// -----------------------------------------------------------------------------
// Importação e deduplicação (Fase 3) — docs/DATABASE.md §4
// -----------------------------------------------------------------------------

enum ImportFileType {
  CSV
  XLSX

  @@map("import_file_type")
}

enum ImportStatus {
  /// Arquivo recebido; aguardando a leitura no worker.
  UPLOADED
  /// Linhas lidas; aguardando mapeamento e configuração do lote.
  MAPPING
  PREVIEWING
  PREVIEW_READY
  COMMITTING
  COMPLETED
  FAILED
  CANCELED

  @@map("import_status")
}

enum DuplicatePolicy {
  /// Cria o lead novo e sinaliza o possível duplicado para revisão.
  CREATE_AND_FLAG
  SKIP
  /// Completa só os campos vazios do lead existente.
  UPDATE_EMPTY_FIELDS

  @@map("duplicate_policy")
}

enum ImportMatchStatus {
  NEW
  EXISTING
  POSSIBLE_DUPLICATE
  DUPLICATE_IN_FILE
  SUPPRESSED
  INVALID

  @@map("import_match_status")
}

enum ImportRowDecision {
  IMPORT
  SKIP
  /// Só registra a origem no lead existente.
  LINK_EXISTING
  UPDATE_EXISTING

  @@map("import_row_decision")
}

enum ImportRowStatus {
  PENDING
  DONE
  ERROR

  @@map("import_row_status")
}

/// Lote de importação de planilha (docs/MVP.md M04).
model ImportBatch {
  id                     String          @id @default(uuid(7)) @db.Uuid
  fileName               String          @map("file_name")
  fileSize               Int             @map("file_size")
  /// Detecta reimportação do mesmo arquivo.
  fileSha256             String          @map("file_sha256")
  fileType               ImportFileType  @map("file_type")
  encoding               String?
  delimiter              String?
  sheetName              String?         @map("sheet_name")
  /// Abas da planilha, para o usuário escolher outra (reenviando o arquivo).
  sheetNames             String[]        @default([]) @map("sheet_names")
  /// Linha do cabeçalho (1 = primeira linha lida).
  headerRow              Int             @default(1) @map("header_row")
  rowCount               Int             @default(0) @map("row_count")
  status                 ImportStatus    @default(UPLOADED)
  /// Coluna → campo, e colunas extras para `custom_fields`.
  mapping                Json?
  duplicatePolicy        DuplicatePolicy @default(CREATE_AND_FLAG) @map("duplicate_policy")
  sourceId               String?         @map("source_id") @db.Uuid
  sourceDetail           String?         @map("source_detail")
  collectedAt            DateTime?       @map("collected_at") @db.Timestamptz(3)
  defaultLegalBasis      LegalBasis?     @map("default_legal_basis")
  legalBasisAssessmentId String?         @map("legal_basis_assessment_id") @db.Uuid
  defaultOwnerId         String?         @map("default_owner_id") @db.Uuid
  defaultTagIds          String[]        @default([]) @map("default_tag_ids") @db.Uuid
  /// Contagens da prévia e do relatório final.
  stats                  Json?
  /// Linhas já processadas na etapa atual (barra de progresso).
  progress               Int             @default(0)
  error                  String?
  createdById            String          @map("created_by_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt            DateTime?       @map("completed_at") @db.Timestamptz(3)
  /// Depois desta data, as linhas temporárias são apagadas (docs/LGPD.md §12).
  purgeAfter             DateTime?       @map("purge_after") @db.Timestamptz(3)

  createdBy    User         @relation("ImportCreator", fields: [createdById], references: [id])
  defaultOwner User?        @relation("ImportDefaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  source       LeadSource?  @relation(fields: [sourceId], references: [id])
  rows         ImportRow[]
  file         ImportFile?
  origins      LeadOrigin[]

  @@index([fileSha256])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([status, purgeAfter])
  @@map("import_batches")
}

/// Bytes do arquivo enviado, só até a leitura no worker (apagados em seguida;
/// docs/SECURITY.md §8: o arquivo não fica guardado).
model ImportFile {
  batchId   String   @id @map("batch_id") @db.Uuid
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("import_files")
}

/// Linha da planilha: valores brutos, normalizados, validação e casamento.
/// Temporária: purgada 30 dias após o lote (docs/LGPD.md §12).
model ImportRow {
  id            String             @id @default(uuid(7)) @db.Uuid
  batchId       String             @map("batch_id") @db.Uuid
  /// Linha na planilha (1 = primeira linha lida, contando o cabeçalho).
  rowNumber     Int                @map("row_number")
  /// Células como texto.
  raw           Json
  normalized    Json?
  errors        Json?
  warnings      Json?
  matchStatus   ImportMatchStatus? @map("match_status")
  matchedLeadId String?            @map("matched_lead_id") @db.Uuid
  matchReasons  Json?              @map("match_reasons")
  decision      ImportRowDecision?
  resultLeadId  String?            @map("result_lead_id") @db.Uuid
  status        ImportRowStatus    @default(PENDING)
  error         String?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, matchStatus])
  /// Anonimização: achar as linhas ainda não purgadas de um lead.
  @@index([resultLeadId])
  @@index([matchedLeadId])
  @@map("import_rows")
}

/// Mapeamento reutilizável, sugerido quando o cabeçalho de uma nova planilha bate.
model ImportMappingTemplate {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  /// Chave do cabeçalho normalizado, para sugerir o modelo automaticamente.
  headerSignature String   @map("header_signature")
  mapping         Json
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation("MappingTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([name])
  @@index([headerSignature])
  @@map("import_mapping_templates")
}

enum DuplicateConfidence {
