// Docline SDR — schema do banco (PostgreSQL)
//
// Fonte conceitual: docs/DATABASE.md. Convenções:
// - tabelas e colunas em snake_case (via @@map/@map), modelos em PascalCase;
// - ids UUIDv7; datas em timestamptz (UTC);
// - sem exclusão física de dados de negócio (status), exceto rotinas de retenção.
//
// Fase 1: identidade (Better Auth + domínio), equipes, convites, auditoria,
// configurações e dados de referência (UFs, municípios, feriados).
// Fase 2: núcleo de leads, timeline, conformidade (base legal, Lista Não
// Contatar, titulares), visões salvas e territórios.
//
// Índices parciais usam o recurso "partialIndexes" (preview do Prisma 7), para
// que a checagem de drift do CI também os cubra (docs/ARCHITECTURE.md §4.1).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Identidade e equipe
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  SDR
  SALES

  @@map("user_role")
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE

  @@map("user_status")
}

/// Usuário interno. Campos base exigidos pelo Better Auth + campos do domínio.
model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  role             UserRole   @default(SDR)
  status           UserStatus @default(INVITED)
  teamId           String?    @map("team_id") @db.Uuid
  timezone         String     @default("America/Fortaleza")
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Verificação em duas etapas (TOTP) ativa (Better Auth, plugin two-factor).
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  team               Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams       Team[]       @relation("TeamManager")
  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  invitations        Invitation[] @relation("InvitationUser")
  createdInvitations Invitation[] @relation("InvitationCreator")

  ownedLeads      Lead[]           @relation("LeadOwner")
  createdLeads    Lead[]           @relation("LeadCreator")
  leadNotes       LeadNote[]       @relation("LeadNoteAuthor")
  assignmentsFrom LeadAssignment[] @relation("AssignmentFrom")
  assignmentsTo   LeadAssignment[] @relation("AssignmentTo")
  assignmentsMade LeadAssignment[] @relation("AssignmentBy")
  territories     UserTerritory[]
  savedViews      SavedView[]

  importBatches      ImportBatch[]           @relation("ImportCreator")
  importsAsOwner     ImportBatch[]           @relation("ImportDefaultOwner")
  mappingTemplates   ImportMappingTemplate[] @relation("MappingTemplateCreator")
  duplicateDecisions DuplicateCandidate[]    @relation("CandidateDecider")
  mergesPerformed    LeadMerge[]             @relation("MergePerformer")

  stageChanges       LeadStageHistory[] @relation("StageChangedBy")
  priorityCities     PriorityCity[]     @relation("PriorityCityCreator")
  scoringModels      ScoringModel[]     @relation("ScoringModelCreator")
  scoringActivations ScoringModel[]     @relation("ScoringModelActivator")

  tasksAssigned      Task[]              @relation("TaskAssignee")
  tasksCompleted     Task[]              @relation("TaskCompletedBy")
  tasksCreated       Task[]              @relation("TaskCreatedBy")
  activities         Activity[]          @relation("ActivityUser")
  messagesSent       Message[]           @relation("MessageSentBy")
  messagesClassified Message[]           @relation("MessageClassifiedBy")
  cadences           Cadence[]           @relation("CadenceCreator")
  enrollments        CadenceEnrollment[] @relation("EnrollmentBy")
  opportunitiesAsSdr Opportunity[]       @relation("OpportunitySdr")
  opportunitiesSales Opportunity[]       @relation("OpportunitySalesOwner")
  notifications      Notification[]      @relation("NotificationUser")

  @@index([role, status])
  @@index([teamId])
  @@map("users")
}

/// Sessão (Better Auth). Token opaco em cookie HttpOnly.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credenciais (Better Auth). `password` guarda apenas o hash.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Tokens de verificação (Better Auth): redefinição de senha etc.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Segundo fator TOTP (Better Auth, plugin two-factor). Segredo e códigos de
/// recuperação ficam cifrados com o segredo da aplicação (BETTER_AUTH_SECRET).
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  /// Falso até o primeiro código válido (a ativação exige confirmar no aplicativo).
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

/// Limites de taxa do Better Auth persistidos no banco (valem entre instâncias).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// Falhas de login recentes (docs/SECURITY.md §12). Chave "pair:<hmac do e-mail>:<ip>"
/// (atraso progressivo só para quem errou, sem trancar o dono da conta) ou
/// "account:<hmac do e-mail>" (alerta ao ADMIN em picos). Linhas paradas há mais
/// de 1 dia são apagadas a cada nova falha.
model LoginThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  alertedAt       DateTime? @map("alerted_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("login_throttles")
}

model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  managerId String?  @map("manager_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  manager User?  @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members User[] @relation("TeamMembers")

  @@map("teams")
}

/// Convite de acesso (sem cadastro público). Guardamos só o hash do token.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("invitations")
}

// -----------------------------------------------------------------------------
// Auditoria e configurações
// -----------------------------------------------------------------------------

enum ActorType {
  USER
  SYSTEM
  AUTOMATION
  INTEGRATION
  AI

  @@map("actor_type")
}

/// Log imutável de mutações e eventos de segurança. UPDATE/DELETE/TRUNCATE são
/// bloqueados por trigger (ver migração); purga só pela rotina de retenção.
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  changes    Json?
  metadata   Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  requestId  String?   @map("request_id")

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("audit_logs")
}

/// Configurações de negócio editáveis (horários, limites, palavras de opt-out…).
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

// -----------------------------------------------------------------------------
// Dados de referência
// -----------------------------------------------------------------------------

model State {
  uf       String @id @db.Char(2)
  name     String
  ibgeCode Int    @unique @map("ibge_code")
  region   String
  timezone String

  municipalities Municipality[]
  leads          Lead[]
  territories    UserTerritory[]

  @@map("states")
}

model Municipality {
  ibgeCode   Int      @id @map("ibge_code")
  name       String
  nameSearch String   @map("name_search")
  uf         String   @db.Char(2)
  ddd        Int?
  timezone   String
  isCapital  Boolean  @default(false) @map("is_capital")
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  population Int?

  state        State           @relation(fields: [uf], references: [uf])
  leads        Lead[]
  territories  UserTerritory[]
  priorityCity PriorityCity?

  @@index([uf, nameSearch])
  @@index([nameSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "municipalities_name_search_trgm_idx")
  @@map("municipalities")
}

enum HolidayScope {
  NATIONAL
  STATE
  MUNICIPAL

  @@map("holiday_scope")
}

/// Feriados e pontos facultativos usados no calendário de cadências.
/// `key` determinística evita duplicidade (ex.: NATIONAL:2026-12-25).
model Holiday {
  id               String       @id @default(uuid(7)) @db.Uuid
  key              String       @unique
  date             DateTime     @db.Date
  scope            HolidayScope
  uf               String?      @db.Char(2)
  municipalityCode Int?         @map("municipality_code")
  name             String
  isOptional       Boolean      @default(false) @map("is_optional")

  @@index([date])
  @@map("holidays")
}

// -----------------------------------------------------------------------------
// Cadastros auxiliares de leads (Fase 2)
// -----------------------------------------------------------------------------

enum LegalBasis {
  CONSENT
  LEGITIMATE_INTEREST
  CONTRACT
  NOT_ASSESSED

  @@map("legal_basis")
}

/// Origem de um lead (Google, indicação, base Docline…). `defaultLegalBasis` é a
/// base legal sugerida no cadastro (docs/LGPD.md §4); o usuário confirma.
model LeadSource {
  id                String     @id @default(uuid(7)) @db.Uuid
  key               String     @unique
  name              String
  defaultLegalBasis LegalBasis @default(NOT_ASSESSED) @map("default_legal_basis")
  position          Int        @default(0)
  active            Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads         Lead[]
  origins       LeadOrigin[]
  importBatches ImportBatch[]
  contactPoints ContactPoint[]

  @@map("lead_sources")
}

model Segment {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads Lead[]

  @@map("segments")
}

model Tag {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  /// Chave sem acento/maiúsculas: impede "Parceiro" e "parceiro" ao mesmo tempo.
  nameSearch  String   @unique @map("name_search")
  color       String   @default("slate")
  category    String?
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads LeadTag[]

  @@map("tags")
}

// -----------------------------------------------------------------------------
// Núcleo de leads (Fase 2)
// -----------------------------------------------------------------------------

enum LeadType {
  ACCOUNTING_FIRM
  ACCOUNTANT
  REFERRAL_PARTNER
  COMPANY
  OTHER

  @@map("lead_type")
}

enum LeadStatus {
  ACTIVE
  ARCHIVED
  MERGED
  ANONYMIZED

  @@map("lead_status")
}

/// Cache do gate de contactabilidade (docs/SDR-FLOW.md §9), para filtros e contagens.
enum ContactStatus {
  CONTACTABLE
  RESTRICTED
  NO_LEGAL_BASIS
  OPTED_OUT
  BLOCKED

  @@map("contact_status")
}

enum LeadCreatedVia {
  MANUAL
  IMPORT
  PROSPECTING
  API
  MERGE

  @@map("lead_created_via")
}

/// Organização prospectada (escritório, empresa, parceiro). Colunas de pipeline,
/// score, atividade e desfecho entram nas Fases 4–5 (docs/DATABASE.md §4.3).
model Lead {
  id                String         @id @default(uuid(7)) @db.Uuid
  /// Código legível sequencial (exibido como L-000123).
  code              Int            @unique @default(autoincrement())
  companyName       String?        @map("company_name")
  tradeName         String?        @map("trade_name")
  /// Nome fantasia ou, na falta, a razão social.
  displayName       String         @map("display_name")
  nameSearch        String         @map("name_search")
  nameCore          String         @map("name_core")
  leadType          LeadType       @default(ACCOUNTING_FIRM) @map("lead_type")
  segmentId         String?        @map("segment_id") @db.Uuid
  category          String?
  cnaeMain          String?        @map("cnae_main") @db.VarChar(7)
  cnpj              String?        @db.VarChar(14)
  cnpjRoot          String?        @map("cnpj_root") @db.VarChar(8)
  /// HMAC do CNPJ (cruzamento com a Lista Não Contatar, como em contact_points).
  cnpjHash          String?        @map("cnpj_hash")
  addressLine       String?        @map("address_line")
  addressNumber     String?        @map("address_number")
  addressComplement String?        @map("address_complement")
  neighborhood      String?
  cityRaw           String?        @map("city_raw")
  municipalityCode  Int?           @map("municipality_code")
  stateUf           String?        @map("state_uf") @db.Char(2)
  postalCode        String?        @map("postal_code") @db.Char(8)
  websiteUrl        String?        @map("website_url")
  websiteDomain     String?        @map("website_domain")
  /// Primeira origem (first-touch); histórico completo em lead_origins.
  originSourceId    String         @map("origin_source_id") @db.Uuid
  originDetail      String?        @map("origin_detail")
  originUrl         String?        @map("origin_url")
  collectedAt       DateTime       @map("collected_at") @db.Timestamptz(3)
  createdVia        LeadCreatedVia @default(MANUAL) @map("created_via")
  ownerId           String?        @map("owner_id") @db.Uuid
  previousOwnerId   String?        @map("previous_owner_id") @db.Uuid
  assignedAt        DateTime?      @map("assigned_at") @db.Timestamptz(3)
  hasPhone          Boolean        @default(false) @map("has_phone")
  hasWhatsapp       Boolean        @default(false) @map("has_whatsapp")
  hasEmail          Boolean        @default(false) @map("has_email")
  hasInstagram      Boolean        @default(false) @map("has_instagram")
  hasWebsite        Boolean        @default(false) @map("has_website")
  contactStatus     ContactStatus  @default(NO_LEGAL_BASIS) @map("contact_status")
  lastActivityAt    DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  status            LeadStatus     @default(ACTIVE)
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(3)
  anonymizedAt      DateTime?      @map("anonymized_at") @db.Timestamptz(3)
  description       String?
  /// Colunas extras de importação, como texto (docs/MVP.md M04).
  customFields      Json?          @map("custom_fields")
  /// Lead que absorveu este na mesclagem (status MERGED).
  mergedIntoId      String?        @map("merged_into_id") @db.Uuid
  /// Etapa atual (Fase 4). Todo cadastro entra em NEW; leads antigos recebem
  /// NEW no seed e na subida do worker (`backfillLeadStages`).
  pipelineId        String?        @map("pipeline_id") @db.Uuid
  stageId           String?        @map("stage_id") @db.Uuid
  stageEnteredAt    DateTime?      @map("stage_entered_at") @db.Timestamptz(3)
  /// Desfecho: preenchidos ao entrar numa etapa de perda (LOST) ou de ganho (WON).
  lostAt            DateTime?      @map("lost_at") @db.Timestamptz(3)
  lossReasonId      String?        @map("loss_reason_id") @db.Uuid
  convertedAt       DateTime?      @map("converted_at") @db.Timestamptz(3)
  /// Cache do último cálculo de score (histórico em lead_score_history).
  score             Int?
  scoreBand         ScoreBand?     @map("score_band")
  scoreModelId      String?        @map("score_model_id") @db.Uuid
  scoreComputedAt   DateTime?      @map("score_computed_at") @db.Timestamptz(3)
  /// Atividade comercial (Fase 5): alimentam a fila, os "esquecidos" e as métricas.
  firstContactAt    DateTime?      @map("first_contact_at") @db.Timestamptz(3)
  /// Último contato de saída (mensagem confirmada ou ligação atendida).
  lastContactAt     DateTime?      @map("last_contact_at") @db.Timestamptz(3)
  firstReplyAt      DateTime?      @map("first_reply_at") @db.Timestamptz(3)
  lastInboundAt     DateTime?      @map("last_inbound_at") @db.Timestamptz(3)
  /// Vencimento da próxima tarefa aberta.
  nextActionAt      DateTime?      @map("next_action_at") @db.Timestamptz(3)
  isTestData        Boolean        @default(false) @map("is_test_data")
  /// Lock otimista: PATCH envia a versão lida; divergência → 409.
  version           Int            @default(1)
  createdById       String?        @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  segment       Segment?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  municipality  Municipality?        @relation(fields: [municipalityCode], references: [ibgeCode])
  state         State?               @relation(fields: [stateUf], references: [uf])
  originSource  LeadSource           @relation(fields: [originSourceId], references: [id])
  owner         User?                @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  people        LeadPerson[]
  contactPoints ContactPoint[]
  origins       LeadOrigin[]
  tags          LeadTag[]
  notes         LeadNote[]
  assignments   LeadAssignment[]
  events        LeadEvent[]
  permissions   ContactPermission[]
  suppressions  SuppressionEntry[]
  dsrs          DataSubjectRequest[]
  mergedInto    Lead?                @relation("LeadMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  absorbed      Lead[]               @relation("LeadMergedInto")
  candidatesA   DuplicateCandidate[] @relation("CandidateA")
  candidatesB   DuplicateCandidate[] @relation("CandidateB")
  merges        LeadMerge[]          @relation("MergeSurvivor")
  mergedAway    LeadMerge[]          @relation("MergeMerged")
  pipeline      Pipeline?            @relation(fields: [pipelineId], references: [id])
  stage         PipelineStage?       @relation(fields: [stageId], references: [id])
  lossReason    LossReason?          @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  scoreModel    ScoringModel?        @relation(fields: [scoreModelId], references: [id], onDelete: SetNull)
  stageHistory  LeadStageHistory[]
  scoreHistory  LeadScoreHistory[]
  tasks         Task[]
  activities    Activity[]
  messages      Message[]
  enrollments   CadenceEnrollment[]
  opportunities Opportunity[]
  notifications Notification[]

  @@unique([cnpj], map: "leads_cnpj_active_key", where: raw("cnpj IS NOT NULL AND status <> 'MERGED'"))
  @@index([cnpjRoot])
  @@index([cnpjHash])
  @@index([ownerId, status])
  @@index([status, stateUf])
  @@index([municipalityCode])
  @@index([contactStatus])
  @@index([lastActivityAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([nameSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_name_search_trgm_idx")
  @@index([nameCore(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_name_core_trgm_idx")
  /// Quadro do pipeline: cards de uma etapa por prioridade.
  @@index([stageId, status, score(sort: Desc)])
  @@index([ownerId, stageId])
  @@index([scoreBand])
  /// Minha Fila: leads do SDR com resposta pendente ou sem atividade.
  @@index([ownerId, lastInboundAt])
  /// Deduplicação por site (mesmo domínio).
  @@index([websiteDomain])
  @@map("leads")
}

enum LeadPersonStatus {
  ACTIVE
  LEFT
  ANONYMIZED

  @@map("lead_person_status")
}

/// Pessoa do lead (contador, sócio, recepção).
model LeadPerson {
  id              String           @id @default(uuid(7)) @db.Uuid
  leadId          String           @map("lead_id") @db.Uuid
  fullName        String           @map("full_name")
  firstName       String?          @map("first_name")
  roleTitle       String?          @map("role_title")
  isPrimary       Boolean          @default(false) @map("is_primary")
  isDecisionMaker Boolean          @default(false) @map("is_decision_maker")
  notes           String?
  status          LeadPersonStatus @default(ACTIVE)
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead          Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactPoints ContactPoint[]
  permissions   ContactPermission[]

  @@index([leadId])
  @@map("lead_people")
}

enum ContactPointType {
  PHONE
  EMAIL
  INSTAGRAM

  @@map("contact_point_type")
}

enum PhoneKind {
  MOBILE
  LANDLINE
  SERVICE
  UNKNOWN

  @@map("phone_kind")
}

enum WhatsappStatus {
  UNKNOWN
  PROBABLE
  CONFIRMED
  NOT_ON_WHATSAPP

  @@map("whatsapp_status")
}

enum ContactPointStatus {
  ACTIVE
  INVALID
  BOUNCED
  WRONG_PERSON
  REMOVED

  @@map("contact_point_status")
}

/// Fonte da verdade dos canais: um registro por valor. WhatsApp é um PHONE com
/// `whatsappStatus` (evita duplicar o mesmo número).
model ContactPoint {
  id                 String             @id @default(uuid(7)) @db.Uuid
  leadId             String             @map("lead_id") @db.Uuid
  personId           String?            @map("person_id") @db.Uuid
  type               ContactPointType
  valueRaw           String             @map("value_raw")
  /// Telefone em E.164; e-mail minúsculo; Instagram sem "@".
  valueNormalized    String             @map("value_normalized")
  /// HMAC do valor normalizado (cruzamento com a Lista Não Contatar).
  valueHash          String             @map("value_hash")
  label              String?
  phoneKind          PhoneKind?         @map("phone_kind")
  whatsappStatus     WhatsappStatus     @default(UNKNOWN) @map("whatsapp_status")
  isPrimary          Boolean            @default(false) @map("is_primary")
  status             ContactPointStatus @default(ACTIVE)
  /// Origem deste dado (LGPD).
  sourceId           String?            @map("source_id") @db.Uuid
  sourceDetail       String?            @map("source_detail")
  collectedAt        DateTime?          @map("collected_at") @db.Timestamptz(3)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  verificationMethod String?            @map("verification_method")
  normalizationFlags String[]           @default([]) @map("normalization_flags")
  createdById        String?            @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead        Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  person      LeadPerson?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  source      LeadSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  permissions ContactPermission[]
  messages    Message[]
  activities  Activity[]

  @@unique([leadId, type, valueNormalized])
  @@unique([leadId, type], map: "contact_points_primary_key", where: raw("is_primary AND status = 'ACTIVE'"))
  @@index([type, valueNormalized])
  @@index([type, valueHash])
  @@index([personId])
  @@map("contact_points")
}

/// Origens de um lead (após mesclagens, pode haver várias). Exatamente uma é a primeira (first-touch).
model LeadOrigin {
  id            String   @id @default(uuid(7)) @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  sourceId      String   @map("source_id") @db.Uuid
  detail        String?
