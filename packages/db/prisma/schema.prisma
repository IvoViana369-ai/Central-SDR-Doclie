  collectedAt   DateTime @map("collected_at") @db.Timestamptz(3)
  referrerName  String?  @map("referrer_name")
  isFirstTouch  Boolean  @default(false) @map("is_first_touch")
  /// Lote de importação de onde o lead (ou esta aparição dele) veio.
  importBatchId String?  @map("import_batch_id") @db.Uuid
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source      LeadSource   @relation(fields: [sourceId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([leadId], map: "lead_origins_first_touch_key", where: raw("is_first_touch"))
  @@index([leadId])
  @@index([importBatchId])
  @@map("lead_origins")
}

model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  addedById String?  @map("added_by_id") @db.Uuid
